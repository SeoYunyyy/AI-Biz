# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=여기에_openai_키_입력

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=여기에_supabase_url_입력
SUPABASE_SERVICE_ROLE_KEY=여기에_supabase_service_role_key_입력
SUPABASE_ANON_KEY=여기에_supabase_anon_key_입력  # 로그인(클라이언트) 용

# ── 로그인 JWT ─────────────────────────────────────────────────
# 미설정 시 FLASK_SECRET_KEY → 기본값 순으로 폴백
JWT_SECRET=여기에_임의의_긴_랜덤문자열_입력

# ── YouTube Data API ───────────────────────────────────────────
YOUTUBE_API_KEY=여기에_youtube_api_키_입력

# ── 네이버 API ─────────────────────────────────────────────────
NAVER_CLIENT_ID=여기에_네이버_client_id_입력
NAVER_CLIENT_SECRET=여기에_네이버_client_secret_입력
