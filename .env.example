# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── 분류기 전략 (llm | ml) ───────────────────────────────────────────────────
# llm  : GPT-4o-mini 기반 분류 (기본값, 별도 서버 불필요)
# ml   : 외부 추론 서버 사용 (추후 CatBoost/LightGBM 등으로 교체 예정)
CLASSIFIER=llm

# ── 네이버 Open API ─────────────────────────────────────────────────────────────
# 발급: https://developers.naver.com/apps/#/register
# 쇼핑 크롤링(Naver Shopping Search API)에 사용
# 없으면 Naver 쇼핑 URL 저장 시 일반 크롤 폴백
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
